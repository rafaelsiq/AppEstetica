rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function linkSecret(token) {
      return get(/databases/$(database)/documents/clientLinks/$(token)/secret/access).data;
    }

    function isLinkOwner(token) {
      return signedIn() && request.auth.uid == linkSecret(token).ownerId;
    }

    function anamneseAnswersOk(answers) {
      return answers is map
        && answers.keys().hasOnly([
          "painAreas",
          "painRadiatesOption",
          "painTypeOptions",
          "painTriggerOptions",
          "painScale",
          "goalOption",
          "playsSport",
          "sportOptions",
          "hadPreviousTreatment",
          "previousTreatmentTypes",
          "aestheticGoalOptions",
          "habitOptions",
          "healthConditions",
          "pregnant",
          "lactating"
        ]);
    }

    function followupAnswersOk(answers) {
      return answers is map
        && answers.keys().hasOnly(["painLevel", "stressLevel", "sleepHours", "sessionType"]);
    }

    function linkPublic(token) {
      return get(/databases/$(database)/documents/clientLinks/$(token)).data;
    }

    function bookingRequestOk() {
      return request.resource.data.keys().hasOnly([
          "clientName",
          "clientPhone",
          "date",
          "period",
          "reasons",
          "status",
          "createdAt"
        ])
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() >= 2
        && request.resource.data.clientName.size() <= 80
        && request.resource.data.clientPhone is string
        && request.resource.data.clientPhone.matches("^\\d{10,13}$")
        && request.resource.data.date is string
        && request.resource.data.date.matches("^\\d{4}-\\d{2}-\\d{2}$")
        && request.resource.data.period in ["manha", "tarde", "noite", "qualquer"]
        && request.resource.data.reasons is list
        && request.resource.data.reasons.size() >= 1
        && request.resource.data.reasons.size() <= 5
        && request.resource.data.reasons.hasOnly([
          "Massagem",
          "Alívio de dor",
          "Estética facial",
          "Estética corporal",
          "Avaliação"
        ])
        && request.resource.data.status == "pendente"
        && request.resource.data.createdAt == request.time;
    }

    function bookingDateOk() {
      let parts = request.resource.data.date.split('-');
      return parts.size() == 3
        && timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) >= request.time - duration.value(36, 'h')
        && timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])) <= request.time + duration.value(181, 'd');
    }

    function availabilityExists(token) {
      return exists(/databases/$(database)/documents/clientLinks/$(token)/availability/off);
    }

    function availabilityData(token) {
      return get(/databases/$(database)/documents/clientLinks/$(token)/availability/off).data;
    }

    function bookingSlotOpen(token) {
      let date = request.resource.data.date;
      let period = request.resource.data.period;
      let slots = availabilityData(token).blockedSlots;
      return !availabilityData(token).blockedDates.hasAny([date])
        && (
          period == "qualquer"
            ? !(
              slots.hasAny([date + "|manha"])
              && slots.hasAny([date + "|tarde"])
              && slots.hasAny([date + "|noite"])
            )
            : !slots.hasAny([date + "|" + period])
        );
    }

    function availabilityOk(data) {
      return data.keys().hasOnly(["closures", "blockedDates", "blockedSlots"])
        && data.closures is list
        && data.closures.size() <= 120
        && data.blockedDates is list
        && data.blockedDates.size() <= 200
        && data.blockedSlots is list
        && data.blockedSlots.size() <= 800;
    }

    function noticeOk(notice) {
      return notice.keys().hasOnly([
          "listName",
          "title",
          "body",
          "imageDataUrl",
          "frequency",
          "date",
          "time",
          "weekdays",
          "monthDay",
          "until",
          "active"
        ])
        && notice.listName is string
        && notice.listName.size() > 0
        && notice.listName.size() <= 80
        && notice.title is string
        && notice.title.size() > 0
        && notice.title.size() <= 80
        && notice.body is string
        && notice.body.size() > 0
        && notice.body.size() <= 400
        && notice.imageDataUrl is string
        && notice.imageDataUrl.size() <= 450000
        && notice.frequency in ["once", "daily", "weekly", "monthly"]
        && notice.date is string
        && (notice.date == "" || notice.date.matches("^\\d{4}-\\d{2}-\\d{2}$"))
        && notice.time is string
        && notice.time.matches("^\\d{2}:\\d{2}$")
        && notice.weekdays is list
        && notice.weekdays.size() <= 7
        && notice.monthDay is int
        && notice.monthDay >= 0
        && notice.monthDay <= 28
        && notice.until is string
        && (notice.until == "" || notice.until.matches("^\\d{4}-\\d{2}-\\d{2}$"))
        && notice.active is bool;
    }

    function consentAnswersOk(answers) {
      return answers is map
        && answers.keys().hasOnly(["imageUse", "signatureName"])
        && answers.imageUse in ["autorizado", "negado"]
        && answers.signatureName is string
        && answers.signatureName.size() > 0
        && answers.signatureName.size() <= 80;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /clientLinks/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isLinkOwner(token)
        && request.resource.data.type in ["anamnese", "acompanhamento", "evolucao", "consentimento", "primeiro"]
        && !request.resource.data.keys().hasAny(["phoneKey", "observations", "comments", "checkpoints", "ownerId", "clientId", "answers"]);
      allow update: if isLinkOwner(token)
        || (
          resource.data.status == "aberto"
          && resource.data.type == "anamnese"
          && request.resource.data.status == "respondido"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["answers", "status", "submittedAt"])
          && anamneseAnswersOk(request.resource.data.answers)
        )
        || (
          resource.data.status == "aberto"
          && resource.data.type == "acompanhamento"
          && request.resource.data.status == "respondido"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["answers", "status", "submittedAt"])
          && followupAnswersOk(request.resource.data.answers)
        )
        || (
          resource.data.status == "aberto"
          && resource.data.type == "consentimento"
          && request.resource.data.status == "respondido"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["answers", "status", "submittedAt"])
          && consentAnswersOk(request.resource.data.answers)
        );
      allow delete: if isLinkOwner(token);

      match /secret/access {
        allow get: if signedIn() && request.auth.uid == resource.data.ownerId;
        allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly(["ownerId", "clientId", "phoneKey", "type"]);
        allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      }

      function deviceOk(data) {
        return data.keys().hasOnly(["endpoint", "p256dh", "auth"])
          && data.endpoint is string
          && data.endpoint.matches("^https://.{10,700}$")
          && data.p256dh is string
          && data.p256dh.matches("^[A-Za-z0-9_-]{20,180}$")
          && data.auth is string
          && data.auth.matches("^[A-Za-z0-9_-]{10,80}$");
      }

      match /devices/{deviceId} {
        allow get, list: if false;
        allow create, update: if deviceId.matches("^[A-Za-z0-9]{16,40}$") && deviceOk(request.resource.data);
        allow delete: if isLinkOwner(token);
      }

      match /notices/{noticeId} {
        allow get, list: if true;
        allow create, update: if isLinkOwner(token) && noticeOk(request.resource.data);
        allow delete: if isLinkOwner(token);
      }

      match /availability/{docId} {
        allow get: if docId == "off";
        allow list: if false;
        allow create, update: if isLinkOwner(token)
          && docId == "off"
          && availabilityOk(request.resource.data);
        allow delete: if isLinkOwner(token) && docId == "off";
      }

      match /views/{phoneKey} {
        allow get: if phoneKey == linkSecret(token).phoneKey || isLinkOwner(token);
        allow list: if false;
        allow create, update, delete: if isLinkOwner(token);
      }

      match /requests/{requestId} {
        allow get, list: if isLinkOwner(token);
        allow create: if linkSecret(token).type == "primeiro"
          && linkPublic(token).status == "ativo"
          && bookingRequestOk()
          && bookingDateOk()
          && (!availabilityExists(token) || bookingSlotOpen(token));
        allow update: if isLinkOwner(token)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hidden"])
          && request.resource.data.hidden == true
          || isLinkOwner(token)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "suggestedDate", "rescheduleReason", "decidedAt"])
          && request.resource.data.status in ["aprovado", "recusado", "remarcacao"]
          && request.resource.data.suggestedDate is string
          && (
            request.resource.data.suggestedDate == ""
            || request.resource.data.suggestedDate.matches("^\\d{4}-\\d{2}-\\d{2}$")
          )
          && request.resource.data.rescheduleReason is string
          && request.resource.data.rescheduleReason.size() <= 400
          && (
            request.resource.data.status != "remarcacao"
            || (
              request.resource.data.rescheduleReason.size() >= 2
              && request.resource.data.suggestedDate.matches("^\\d{4}-\\d{2}-\\d{2}$")
            )
          );
        allow delete: if isLinkOwner(token);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
