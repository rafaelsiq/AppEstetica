## Backend environment variables
#
# Prefer setting DB_URI directly. For MongoDB Atlas, you can copy the connection
# string from Atlas and replace <user>/<password>/<db>.
#
# Example:
# DB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
#
# For local MongoDB:
# DB_URI=mongodb://localhost:27017/app-estetica

DB_URI=mongodb://localhost:27017/app-estetica

## Optional (only used if DB_URI is not provided)
DB_HOST=localhost:27017
DB_NAME=app-estetica
DB_USER=
DB_PASS=
